          "description": "true keeps only classified products, false only unclassified ones; omitted keeps both",
          "type": [
            "null",
            "boolean"
          ]
        },
        "cursor": {
          "description": "the opaque next_cursor returned by the previous page; omitted means the first page",
          "type": "string"
        },
        "handling_tag": {
          "description": "keep only products whose classification carries this tag: Hazmat, Fragile, TemperatureSensitive, Oversized or HighValue",
          "type": "string"
        },
        "limit": {
          "description": "page size, 1..500; omitted or 0 means 100",
          "type": "integer"
        }
