  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "WRITE. Declare one packaging level of a registered SKU with its GTIN (ADR 0011): level EACH, INNER, CASE or PALLET; every level but EACH names its child_gtin (an active lower level of this SKU) and qty_of_child (at least 2). A GTIN identifies exactly one (sku, level), fleet-wide. The content quantity of an ACTIVE level never changes: declaring the same gtin with another quantity fails with pack-quantity-immutable; a new quantity needs a NEW gtin at that level, which end-dates the old level (kept, reason superseded). Repeating an identical declaration changes nothing. Raises ProductPackLevelDeclared (and ProductPackLevelRetired when it supersedes). Fails with invalid-gtin, variable-measure-unsupported, invalid-pack-level, invalid-pack-quantity, pack-level-order, pack-dimensions-below-contents, gtin-already-assigned or product-not-found.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "child_gtin": {
          "description": "the GTIN of the next lower level this one is made of; required for every level but EACH, omitted for EACH",
          "type": "string"
        },
        "dims": {
          "additionalProperties": false,
          "description": "optional declared dimensions and weight of one pack; omitted means none declared",
          "properties": {
            "height_mm": {
              "description": "height of one pack in millimetres, 1..20000",
              "type": "integer"
            },
            "length_mm": {
              "description": "length of one pack in millimetres, 1..20000",
              "type": "integer"
            },
            "weight_g": {
              "description": "weight of one pack in grams, 1..2000000",
              "type": "integer"
            },
            "width_mm": {
              "description": "width of one pack in millimetres, 1..20000",
              "type": "integer"
            }
          },
          "required": [
            "length_mm",
            "width_mm",
            "height_mm",
            "weight_g"
          ],
          "type": [
            "null",
            "object"
          ]
        },
        "gtin": {
          "description": "the GTIN of this level (8, 12, 13 or 14 digits, valid mod-10 check digit; indicator digit 9 is rejected)",
          "type": "string"
        },
        "is_despatch_unit": {
          "description": "optional; true when this level ships as a unit; omitted means false",
          "type": "boolean"
        },
        "is_orderable": {
          "description": "optional; true when this level can be ordered from the supplier; omitted means false",
          "type": "boolean"
        },
        "level": {
          "description": "the packaging level: EACH, INNER, CASE or PALLET",
          "type": "string"
        },
        "qty_of_child": {
          "description": "how many child packs make one of this level, at least 2; required for every level but EACH, omitted for EACH",
          "type": "integer"
        },
        "sku": {
          "description": "the product's SKU (1..64 characters, no whitespace, control characters or '/'), e.g. SKU-1",
          "type": "string"
        },
        "units_per_pack": {
          "description": "optional direct factor to eaches; omitted means qty_of_child times the child's factor, a given value must equal that",
          "type": "integer"
        }
      },
      "required": [
        "sku",
        "level",
        "gtin"
      ],
      "type": "object"
    },
